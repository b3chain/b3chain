[Unit]
Description=B3Chain Stratum V1 to V2 translator
After=network-online.target b3chain-pool-stratum-v2.service
Wants=network-online.target
PartOf=b3chain-pool.target

[Service]
Type=simple
User=b3chain-pool
Group=b3chain-pool
EnvironmentFile=/etc/b3chain-pool/pool.env
WorkingDirectory=/usr/local/lib/b3chain-pool
ExecStart=/usr/bin/node /usr/local/lib/b3chain-pool/dist/sv2/translator/main.js
Restart=on-failure
RestartSec=5s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/b3chain-pool
RuntimeDirectory=b3chain-pool
RuntimeDirectoryMode=0750

AmbientCapabilities=

StandardOutput=append:/var/log/b3chain-pool/translator.log
StandardError=append:/var/log/b3chain-pool/translator.log

[Install]
WantedBy=multi-user.target
