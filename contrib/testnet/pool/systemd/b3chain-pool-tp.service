[Unit]
Description=B3Chain Stratum V2 Template Provider
After=network-online.target b3chaind-testnet.service
Wants=network-online.target
PartOf=b3chain-pool.target

[Service]
Type=simple
User=b3chain-pool
Group=b3chain-pool
EnvironmentFile=/etc/b3chain-pool/pool.env
WorkingDirectory=/usr/local/lib/b3chain-pool
ExecStart=/usr/bin/node /usr/local/lib/b3chain-pool/dist/sv2/tp/main.js
Restart=on-failure
RestartSec=5s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/b3chain-pool
RuntimeDirectory=b3chain-pool
RuntimeDirectoryMode=0750

AmbientCapabilities=

StandardOutput=append:/var/log/b3chain-pool/tp.log
StandardError=append:/var/log/b3chain-pool/tp.log

[Install]
WantedBy=multi-user.target
