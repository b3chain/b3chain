[Unit]
Description=B3Chain pool daemon (template poller, share writer, PPLNS, payouts)
After=network-online.target b3chaind-testnet.service postgresql.service
Wants=network-online.target
PartOf=b3chain-pool.target

[Service]
Type=simple
User=b3chain-pool
Group=b3chain-pool
EnvironmentFile=/etc/b3chain-pool/pool.env
WorkingDirectory=/usr/local/lib/b3chain-pool
ExecStart=/usr/bin/node /usr/local/lib/b3chain-pool/dist/pool/main.js
Restart=on-failure
RestartSec=5s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/b3chain-pool /run/b3chain-pool
RuntimeDirectory=b3chain-pool
RuntimeDirectoryMode=0750

StandardOutput=append:/var/log/b3chain-pool/daemon.log
StandardError=append:/var/log/b3chain-pool/daemon.log

[Install]
WantedBy=multi-user.target
