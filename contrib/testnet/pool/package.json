{
  "name": "b3chain-pool",
  "version": "0.1.0",
  "private": true,
  "description": "B3Chain Stratum V1 mining pool (stratum server, pool daemon, web UI)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy-vendor",
    "copy-vendor": "node scripts/copy-vendor.js",
    "postinstall": "node scripts/copy-vendor.js",
    "start:stratum": "node dist/stratum/main.js",
    "start:daemon": "node dist/pool/main.js",
    "start:web": "node dist/web/main.js",
    "dev:stratum": "tsx watch src/stratum/main.ts",
    "dev:daemon": "tsx watch src/pool/main.ts",
    "dev:web": "tsx watch src/web/main.ts",
    "migrate": "tsx src/cli/migrate.ts",
    "pay-now": "tsx src/cli/pay-now.ts",
    "recompute-pplns": "tsx src/cli/recompute-pplns.ts",
    "seed-admin": "tsx src/cli/seed-admin.ts",
    "sv2-keys": "tsx src/cli/sv2-keys.ts",
    "start:stratum-v2": "node dist/sv2/mining/main.js",
    "start:tp": "node dist/sv2/tp/main.js",
    "start:translator": "node dist/sv2/translator/main.js",
    "dev:stratum-v2": "tsx watch src/sv2/mining/main.ts",
    "dev:tp": "tsx watch src/sv2/tp/main.ts",
    "dev:translator": "tsx watch src/sv2/translator/main.ts",
    "test": "node --env-file=.env.test --test --import tsx tests/*.test.ts",
    "test:e2e": "node --test --import tsx tests/e2e/*.test.ts"
  },
  "dependencies": {
    "@noble/ciphers": "^1.0.0",
    "@noble/curves": "^1.4.0",
    "@noble/hashes": "^1.4.0",
    "argon2": "^0.40.3",
    "chart.js": "^4.4.3",
    "socket.io-client": "^4.7.5",
    "cookie-session": "^2.1.0",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "nodemailer": "^6.9.14",
    "otplib": "^12.0.1",
    "pg": "^8.12.0",
    "pino": "^9.4.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@scure/base": "^1.1.6",
    "@types/cookie-session": "^2.0.49",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^6.4.15",
    "@types/pg": "^8.11.6",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
