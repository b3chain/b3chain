# B3Chain Stratum Mining Pool — environment template
# Copy to /etc/b3chain-pool/pool.env and fill in real values.
# All three services (stratum, daemon, web) load this file.

# ---- b3chaind RPC ----
B3POOL_RPC_HOST=127.0.0.1
B3POOL_RPC_PORT=18534
B3POOL_RPC_USER=b3chain
# Either set B3POOL_RPC_PASSWORD directly, or point _FILE at a file:
B3POOL_RPC_PASSWORD=
B3POOL_RPC_PASSWORD_FILE=/etc/b3chain/rpcpassword
B3POOL_PAYOUT_WALLET=pool-payouts
B3POOL_NETWORK=testnet

# ---- PostgreSQL ----
# postgres://user:pass@host:port/dbname
B3POOL_DB_URL=postgres://b3chain_pool:CHANGE_ME@127.0.0.1:5432/b3chain_pool

# ---- Stratum server ----
B3POOL_STRATUM_BIND=0.0.0.0
B3POOL_STRATUM_PORT=3333
B3POOL_STRATUM_DEFAULT_DIFF=1024
B3POOL_STRATUM_VARDIFF_TARGET_S=10
B3POOL_STRATUM_VARDIFF_RETUNE_S=30
B3POOL_FEE_PERCENT=1.0

# ---- Pool daemon ----
B3POOL_TEMPLATE_POLL_MS=2000
B3POOL_PAYOUT_INTERVAL_MS=3600000
B3POOL_BLOCK_CONFIRMATIONS=100
B3POOL_PPLNS_N_SHARES=4032

# Local UNIX socket between stratum and daemon
B3POOL_SHARE_SOCKET=/run/b3chain-pool/share.sock

# ---- Web ----
B3POOL_WEB_BIND=127.0.0.1
B3POOL_WEB_PORT=5100
B3POOL_BASE_URL=https://pool.b3chain.org
# Cookie signing secret: 32+ bytes. Generate with: openssl rand -hex 32
B3POOL_COOKIE_SECRET=CHANGE_ME_TO_LONG_RANDOM_SECRET
B3POOL_SESSION_HOURS=168

# ---- SMTP / email ----
B3POOL_SMTP_HOST=127.0.0.1
B3POOL_SMTP_PORT=25
B3POOL_SMTP_FROM=B3Chain Pool <noreply@b3chain.org>
# Set if relay needs auth; leave blank for local Postfix
B3POOL_SMTP_USER=
B3POOL_SMTP_PASS=

# ---- Stratum V2 (opt-in) ----
B3POOL_SV2_ENABLE=false
B3POOL_SV2_BIND=0.0.0.0
B3POOL_SV2_PORT=3336
# Long-lived Ed25519 root that signs the pool static cert.
B3POOL_SV2_AUTHORITY_KEY_FILE=/etc/b3chain-pool/sv2-authority.key
# Per-pool X25519 static key, rotated when the cert expires.
B3POOL_SV2_STATIC_KEY_FILE=/etc/b3chain-pool/sv2-static.key
# 90-day cert binding the static key to the authority key.
B3POOL_SV2_CERT_FILE=/etc/b3chain-pool/sv2-cert.bin
B3POOL_SV2_CERT_VALIDITY_DAYS=90

# ---- Template Provider ----
B3POOL_TP_BIND=127.0.0.1
B3POOL_TP_PORT=8442
B3POOL_TP_POLL_MS=2000

# ---- Job Declaration server ----
B3POOL_JD_ENABLE=false
B3POOL_JD_BIND=0.0.0.0
B3POOL_JD_PORT=34264
B3POOL_JD_TOKEN_TTL_MS=300000

# ---- V1<->V2 translator ----
B3POOL_TRANSLATOR_ENABLE=false
B3POOL_TRANSLATOR_BIND=0.0.0.0
B3POOL_TRANSLATOR_PORT=3337
B3POOL_TRANSLATOR_UPSTREAM=127.0.0.1:3336

# ---- Logging ----
B3POOL_LOG_LEVEL=info
