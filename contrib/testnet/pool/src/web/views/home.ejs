<%- include('partials/header') %>

<section class="hero">
  <h1>B3Chain Mining Pool</h1>
  <p class="subtitle">Stratum V1 mining pool for B3Chain <%= network %>. PPLNS over <%= pplnsNShares %> shares, <%= feePercent %>% fee. <% if (payoutHourly) { %>The payout job runs hourly<% } else { %>The payout job runs on its configured interval<% } %> after <%= confirmationsRequired %> confirmations, to a verified account with a valid <%= network %> address and a balance of at least the minimum. New accounts start at 1 B3C.</p>
  <div class="copy-row">
    <code id="pool-url"><%= poolUrl %></code>
    <button class="btn-secondary" type="button" id="copy-pool-url">Copy</button>
  </div>
  <div class="cta-row">
    <a class="btn-primary" href="/getting-started">Start mining</a>
    <a class="btn-secondary" href="/blocks">Recent blocks</a>
  </div>
</section>

<section>
  <h2>Pool stats</h2>
  <p id="live-status" class="muted" role="status" hidden></p>
  <p id="share-note" class="muted" role="status" hidden></p>
  <div class="grid-3">
    <div class="tile"><div class="tile-label">Share hashrate (5 min)</div><div class="tile-value" id="pool-hashrate">…</div></div>
    <div class="tile"><div class="tile-label">Connected miners</div><div class="tile-value" id="pool-miners">…</div></div>
    <div class="tile"><div class="tile-label">Work height</div><div class="tile-value" id="pool-height">…</div></div>
    <div class="tile"><div class="tile-label">Pool blocks found</div><div class="tile-value" id="pool-blocks"><%= blocksFound %></div></div>
  </div>
  <div class="range-row">
    <button type="button" class="btn-secondary" data-range="1h" aria-pressed="true">1h</button>
    <button type="button" class="btn-secondary" data-range="24h">24h</button>
    <button type="button" class="btn-secondary" data-range="7d">7d</button>
    <button type="button" class="btn-secondary" data-range="30d">30d</button>
  </div>
  <canvas id="pool-chart" height="120" aria-label="Share hashrate over time"></canvas>
</section>

<section>
  <h2>Last 10 pool blocks</h2>
  <p id="no-blocks" <%= blocks.length === 0 ? '' : 'hidden' %>>No blocks yet. Be the first finder.</p>
  <div class="table-scroll" id="blocks-table-wrap" <%= blocks.length === 0 ? 'hidden' : '' %>>
  <table id="blocks-table">
    <thead><tr><th>Height</th><th>Hash</th><th>Reward</th><th>Confirmations</th><th>When</th></tr></thead>
    <tbody id="recent-blocks">
    <% blocks.forEach(b => { %>
      <tr>
        <td><%= b.height %></td>
        <td class="mono"><a href="/blocks/<%= b.hash %>"><%= String(b.hash).slice(0, 16) %>…</a></td>
        <td class="num"><%= Number(b.reward_b3c).toFixed(4) %> B3C</td>
        <td class="num">
          <% if (b.is_orphan) { %>
            <span class="tag tag-fail">orphan</span>
          <% } else if (b.is_confirmed) { %>
            <span class="tag tag-pass">confirmed</span>
          <% } else { %>
            <%= b.confirmations %>/<%= confirmationsRequired %>
          <% } %>
        </td>
        <td class="muted"><time data-ts="<%= b.found_at %>"><%= b.found_at %></time></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  </div>
</section>

<script src="/vendor/socket.io.min.js?v=20260926"></script>
<script src="/vendor/chart.umd.js?v=20260926"></script>
<script id="pool-buckets" type="application/json"><%- JSON.stringify(buckets || []).replace(/</g, "\\u003c") %></script>
<script src="/js/home.js?v=20260926c"></script>

<%- include('partials/footer') %>
