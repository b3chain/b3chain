<%- include('../partials/header') %>
<%- include('partials/dashnav') %>

<section>
  <h1>Workers</h1>
  <% if (workers.length === 0) { %>
    <p class="muted">No workers yet. Connect a miner with username <code><%= user.email %>.&lt;workerName&gt;</code>.</p>
  <% } else { %>
    <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Difficulty</th>
          <th>1h hashrate</th>
          <th>Accepted</th>
          <th>Rejected</th>
          <th>Last share</th>
        </tr>
      </thead>
      <tbody>
      <% workers.forEach(w => {
           const rejected = Number(w.rejected_duplicate) + Number(w.rejected_low_diff) + Number(w.rejected_invalid) + Number(w.rejected_other);
           const diff = w.live_difficulty != null ? w.live_difficulty : w.last_difficulty;
      %>
        <tr>
          <td class="mono"><%= w.name %></td>
          <td><%= diff == null ? '—' : Number(diff) %></td>
          <td><%= formatHashrate(Number(w.h_hour)) %></td>
          <td><%= w.shares_total %></td>
          <td title="duplicate <%= w.rejected_duplicate %>, low-diff <%= w.rejected_low_diff %>, invalid <%= w.rejected_invalid %>, other <%= w.rejected_other %>">
            <%= rejected %><% if (w.last_reject_reason) { %> <span class="muted">(<%= w.last_reject_reason %>)</span><% } %>
          </td>
          <td class="muted">
            <% if (w.last_share_at) { %><time data-ts="<%= w.last_share_at %>"><%= w.last_share_at %></time>
            <% } else { %>—<% } %>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
    </div>
  <% } %>
</section>

<%
function formatHashrate(h) {
  if (h >= 1e15) return (h/1e15).toFixed(2) + ' PH/s';
  if (h >= 1e12) return (h/1e12).toFixed(2) + ' TH/s';
  if (h >= 1e9)  return (h/1e9).toFixed(2)  + ' GH/s';
  if (h >= 1e6)  return (h/1e6).toFixed(2)  + ' MH/s';
  if (h >= 1e3)  return (h/1e3).toFixed(2)  + ' kH/s';
  return h.toFixed(2) + ' H/s';
}
%>

<%- include('../partials/footer') %>
