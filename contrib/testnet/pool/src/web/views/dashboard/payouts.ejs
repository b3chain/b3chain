<%- include('../partials/header') %>
<%- include('partials/dashnav') %>

<section>
  <h1>Payouts</h1>
  <div class="grid-3">
    <div class="tile"><div class="tile-label">Spendable balance</div><div class="tile-value"><%= balance.toFixed(8) %> B3C</div></div>
    <div class="tile"><div class="tile-label">Estimated immature</div><div class="tile-value"><%= Number(immature).toFixed(8) %> B3C</div></div>
    <div class="tile"><div class="tile-label">Minimum payout</div><div class="tile-value"><%= minimum.toFixed(2) %> B3C</div></div>
  </div>
  <p><%= readiness.message %></p>
  <p class="muted">Estimated immature is your share of unconfirmed blocks. It is credited after confirmation and is not spendable yet.</p>
  <% if (payouts.length === 0) { %>
    <p class="muted">No payouts yet.</p>
  <% } else { %>
    <div class="table-scroll">
    <table>
      <thead><tr><th>When</th><th>Amount</th><th>To</th><th>TXID</th><th>Confirmed?</th></tr></thead>
      <tbody>
      <% payouts.forEach(p => { %>
        <tr>
          <td class="muted"><time data-ts="<%= p.sent_at %>"><%= p.sent_at %></time></td>
          <td><%= Number(p.amount_b3c).toFixed(8) %> B3C</td>
          <td class="mono"><%= p.address %></td>
          <td class="mono"><a href="<%= explorerTxUrl(p.txid) %>" target="_blank" rel="noopener"><%= p.txid.slice(0, 16) %>…</a></td>
          <td><%= p.confirmed ? 'yes' : 'no' %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
    </div>
  <% } %>
</section>

<%- include('../partials/footer') %>
