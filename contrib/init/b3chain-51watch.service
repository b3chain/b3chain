[Unit]
Description=B3Chain 51%-attack early-warning monitor
Documentation=file:///opt/b3chain/b3chain/doc/security/51-MONITORING-OPS.md
After=network-online.target
Wants=network-online.target
Requires=b3chaind-testnet.service
After=b3chaind-testnet.service
# b3chaind on seed1 IS managed by systemd as b3chaind-testnet.service
# (added 2026-05-20 after the v1.1.3 cold-start succeeded).

[Service]
Type=simple
User=deploy
Group=deploy
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/b3chain/51watch.env

# Testnet-tuned thresholds for the legacy RPC detectors (chain=test on seed1).
# When seed1 flips to chain=main, re-tune to:
#   --chain main --rpc-port 8532 --dedup-window 300 --hashrate-drop 0.50
#   and update --debug-log to /var/lib/b3chain/.b3chain/debug.log (mainnet has
#   no chain subdir).
# New (runbook-§0) detectors use defaults matching the runbook table:
#   --long-reorg-depth 50, --pow-budget-rate 100/h, --pow-budget-window 3600,
#   --hashrate-sustained-drop 0.70, --hashrate-sustained-window 3600.
# Default --pow-budget-rate 100/h is fine for testnet too (peer-misbehaviour
# signal, not a routine event).
ExecStart=/usr/bin/python3 /opt/b3chain/b3chain/contrib/monitoring/51attack-watch.py \
    --rpc-port 18534 \
    --chain test \
    --rpc-user b3chain \
    --rpc-password ${RPCPASSWORD} \
    --debug-log /var/lib/b3chain/.b3chain/testnet3/debug.log \
    --interval 30 \
    --dedup-window 600 \
    --hashrate-drop 0.30

StandardOutput=append:/var/log/b3chain/51watch.jsonl
StandardError=journal
Restart=on-failure
RestartSec=15s

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/log/b3chain
# Read-only access to b3chaind's datadir is required so the log tailer
# can open debug.log once the b3chain:deploy group-read perm gap is
# fixed.  Until then this directive is a no-op because the deploy user
# is blocked by Unix DAC perms anyway, but having it here means the
# moment the perms get widened (sudo usermod -aG b3chain deploy + acl
# on the testnet3 dir), the log-tail detectors become active on the
# next systemctl restart with no additional unit-file change needed.
ReadOnlyPaths=/var/lib/b3chain/.b3chain

[Install]
WantedBy=multi-user.target
