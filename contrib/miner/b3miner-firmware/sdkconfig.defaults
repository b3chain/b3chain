# B3Miner-1 defaults — tune per board spin
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# XCKU5P-2FFVB676 initial network path: ESP32-S3 Wi-Fi.
CONFIG_B3_NETWORK_WIFI=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# TLS for Stratum (V1 stratum+ssl / future V2)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# HTTP server + WebSocket dashboard
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# OTA — enable signed images in production (see b3_ota/README.md)
# CONFIG_SECURE_BOOT=y
# CONFIG_SECURE_SIGNED_APPS_SCHEME_RSA_3072=y

# Log level (override in menuconfig for field debug)
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ATECC608B on GPIO 1 (SDA) and GPIO 2 (SCL), I2C port 0, 400 kHz.
CONFIG_ATCA_HAL_I2C=y
CONFIG_ATCA_I2C_SDA_PIN=1
CONFIG_ATCA_I2C_SCL_PIN=2
CONFIG_ATCA_I2C_BUS=0
CONFIG_ATCA_I2C_SPEED=400000
CONFIG_ATCA_I2C_ADDRESS=192
