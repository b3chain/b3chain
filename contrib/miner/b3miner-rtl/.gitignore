# --- Vivado ---
build/*.xpr
build/*.cache/
build/*.hw/
build/*.runs/
build/*.sim/
build/*.ip_user_files/
build/*.gen/
build/*.srcs/
build/*.Xil/
build/*.jou
build/*.log
build/*.str
build/*.tcl.bak
build/.Xil/
vivado*.jou
vivado*.log
.Xil/

# --- Vivado generated artifacts (keep the dir, gitignore the contents) ---
build/artifacts/*
!build/artifacts/.gitkeep
build/reports/*
!build/reports/.gitkeep

# --- Verilator ---
sim/verilator/obj_dir/
sim/verilator/*.vcd
sim/verilator/*.fst

# --- XSIM ---
sim/xsim/xsim.dir/
sim/xsim/*.jou
sim/xsim/*.log
sim/xsim/*.pb
sim/xsim/*.wdb

# --- Generated test vectors (regenerated by ref/gen_vectors.py) ---
sim/vectors/*.hex

# --- Python ---
__pycache__/
*.pyc
.pytest_cache/
ref/.venv/
ref/venv/

# --- Editor / OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
