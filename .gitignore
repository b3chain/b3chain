# Patterns that are specific to a text editor, IDE, operating system, or user
# environment are not added here. They should be added to your local gitignore
# file instead:
# https://docs.github.com/en/get-started/git-basics/ignoring-files#configuring-ignored-files-for-all-repositories-on-your-computer

# Build subdirectories.
/*build*
!/build-aux
!/build_msvc

*.pyc

# Only ignore unexpected patches
*.patch
!contrib/guix/patches/*.patch
!depends/patches/**/*.patch

/CMakeUserPresets.json

# Previous releases
/releases

# cargo default target dir
target/

/guix-build-*

/ci/scratch/

# Local audit run log directories (created by verify-phase11.sh,
# audit-stratum-pool.sh, audit-stratum-v2.sh, etc. on failure).
/.verify-phase11-last-run/
/.audit-stratum-pool-last-run/
/.audit-stratum-v2-last-run/

# Bitcoin-inheritance audit per-host logs (multi-MB ctest + functional
# stdout dumps produced by contrib/testing/audit/audit-bitcoin-
# inheritance.sh).  The summary JSON is committed under
# contrib/testing/results/<utc-timestamp>/.
/.inheritance-logs/

# Per-script audit log directories created by individual Phase 11
# audits when they need a scratch location.
contrib/testing/audit/results/

# Windows test UI / live mining dashboard (created by
# contrib/miner/tests/run_tests_ui.bat).
contrib/miner/tests/.venv/
contrib/miner/tests/.miner_settings.json
contrib/miner/tests/mining-session-*/
contrib/miner/tests/report-*.json
contrib/miner/tests/report-*.md
